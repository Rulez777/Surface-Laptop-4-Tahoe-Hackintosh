# Surface Laptop 4 Intel Tiger Lake-U UART patch for Xiashangning/VoodooSerial.
# Adds PCI ID 8086:A0A8 and the 16/25 LPSS clock ratio used by the UART driver.

diff --git a/VoodooSerial/Info.plist b/VoodooSerial/Info.plist
index b8fd797..97f1db0 100644
--- a/VoodooSerial/Info.plist
+++ b/VoodooSerial/Info.plist
@@ -64,7 +64,7 @@
 			<key>IOClass</key>
 			<string>VoodooUARTController</string>
 			<key>IOPCIMatch</key>
-			<string>0x34a88086 0x9d278086</string>
+			<string>0x34a88086 0x9d278086 0xa0a88086</string>
 			<key>IOProbeScore</key>
 			<integer>400</integer>
 			<key>IOProviderClass</key>
diff --git a/VoodooSerial/VoodooUART/VoodooUARTController.cpp b/VoodooSerial/VoodooUART/VoodooUARTController.cpp
index 5094097..4d57ca6 100644
--- a/VoodooSerial/VoodooUART/VoodooUARTController.cpp
+++ b/VoodooSerial/VoodooUART/VoodooUARTController.cpp
@@ -102,6 +102,8 @@ void VoodooUARTController::startUARTClock() {
         writeRegister(UART_UPDATE_CLK | CALC_CLK(8, 15) | UART_ENABLE_CLK, LPSS_PRIV + LPSS_UART_CLK);
     else if (device.device_id == 0x9d27)
         writeRegister(UART_UPDATE_CLK | CALC_CLK(2, 5) | UART_ENABLE_CLK, LPSS_PRIV + LPSS_UART_CLK);
+    else if (device.device_id == 0xa0a8) // Tiger Lake-U UART0: 100 MHz LPSS clock -> 64 MHz
+        writeRegister(UART_UPDATE_CLK | CALC_CLK(16, 25) | UART_ENABLE_CLK, LPSS_PRIV + LPSS_UART_CLK);
     else
         LOG("Unknown UART type");
 }
