diff --git a/WhateverXe/kern_mtl_posh_fix.hpp b/WhateverXe/kern_mtl_posh_fix.hpp
new file mode 100644
index 0000000..88db099
--- /dev/null
+++ b/WhateverXe/kern_mtl_posh_fix.hpp
@@ -0,0 +1,59 @@
+// -wex-mtl-poshfix: WindowServer memory leak in the TGL Metal donor driver
+// (AppleIntelTGLGraphicsMTLDriver 16.0.0, GPUDriversIntel-165, file sha256
+// 1e5e4f5b...c6c from the WhateverXe Graphics package).
+//
+// -[MTLIGAccelCommandBuffer initWithQueue:...] allocates a 0x12010-byte POSH
+// target (operator new, 96 KB in the medium malloc zone) whenever the queue
+// has no active command buffer and the queue's shared m_pPoshUsedAsTarget is
+// NULL, and marks the buffer m_isOnlyActiveCommandBuffer. The queue's shared
+// pointer is only ever cleared (queue init) and never assigned, so that path
+// is taken for nearly every command buffer. -dealloc deletes the POSH target
+// only when !m_isOnlyActiveCommandBuffer, so every one of them leaks:
+// WindowServer grows by roughly one 96 KB block per composited frame.
+//
+// The buffer is owned by the command buffer alone (the queue never holds it),
+// and dealloc runs after completion, so deleting it there is what the
+// non-only-active path already does. The fix drops the m_isOnlyActive test in
+// -dealloc (jne -> 2 NOPs) when the page holding it is validated on page-in.
+#ifndef kern_mtl_posh_fix_hpp
+#define kern_mtl_posh_fix_hpp
+#include <stddef.h>
+#include <stdint.h>
+#include <string.h>
+
+namespace MTLPoshFix {
+// -[MTLIGAccelCommandBuffer dealloc] +0xB1 .. +0xDC (file offset 0x7ED6B):
+//   mov rbx,[rip+ivar _pPoshUsedAsTarget]; mov rdi,[r14+rbx]; test rdi,rdi; je;
+//   mov rax,[rip+ivar m_isOnlyActiveCommandBuffer]; cmp byte [r14+rax],0;
+//   jne skip; call operator delete; mov qword [r14+rbx],0
+constexpr uint8_t Find[43] {
+    0x48,0x8B,0x1D,0x3E,0xB1,0x41,0x00,0x49,0x8B,0x3C,0x1E,0x48,0x85,0xFF,0x74,0x1B,
+    0x48,0x8B,0x05,0x26,0xB1,0x41,0x00,0x41,0x80,0x3C,0x06,0x00,0x75,0x0D,0xE8,0x7A,
+    0xFA,0x01,0x00,0x49,0xC7,0x04,0x1E,0x00,0x00,0x00,0x00};
+constexpr size_t PageSize=0x1000, PageOffset=0x7ED6B&(PageSize-1), JumpOffset=0x1C;
+static_assert(PageOffset+sizeof(Find)<=PageSize,"pattern must not cross a page");
+
+inline bool matches(const uint8_t *at) {
+    return at && !memcmp(at,Find,sizeof(Find));
+}
+// Patch an already matched site in place. Returns true when bytes changed.
+inline bool apply(uint8_t *at) {
+    if(!matches(at))return false;
+    at[JumpOffset]=0x90;at[JumpOffset+1]=0x90;
+    return true;
+}
+// Every site in a validated range [data, data+size). Validation ranges are not
+// guaranteed to start at the page holding file offset 0x7E000, so search the
+// whole range instead of a fixed in-page offset; the 43 bytes include two
+// RIP-relative ivar displacements and a call displacement unique to this file.
+template<class F> size_t forEachMatch(const uint8_t *data,uint64_t size,F f) {
+    size_t n=0;
+    if(!data || size<sizeof(Find))return 0;
+    for(uint64_t o=0;o+sizeof(Find)<=size;++o)
+        if(data[o]==Find[0] && data[o+1]==Find[1] && data[o+2]==Find[2] && data[o+3]==Find[3] && matches(data+o)) {
+            f(const_cast<uint8_t *>(data+o));++n;o+=sizeof(Find)-1;
+        }
+    return n;
+}
+}
+#endif
diff --git a/WhateverXe/kern_sl4_dmc_trial.hpp b/WhateverXe/kern_sl4_dmc_trial.hpp
new file mode 100644
index 0000000..58460ea
--- /dev/null
+++ b/WhateverXe/kern_sl4_dmc_trial.hpp
@@ -0,0 +1,52 @@
+#pragma once
+/* Experimental local-only Surface Laptop 4 TGL DMC v2.12 loader.
+ * This is NOT activated unless the explicitly opt-in WEX hook qualifies the
+ * donor image, and no live EFI or MMIO write is performed by the build.
+ * See scripts/inspect_tgl_dmc.py for verified fixed-size MMIO layout.
+ */
+#include <stdint.h>
+#include "kern_sl4_dmc_trial_data.hpp"
+
+namespace SL4DMCTrial {
+static constexpr uint64_t kManagerOffset=0xC40;
+static constexpr uint32_t kExpectedFirst=0x0C004040;
+static constexpr uint32_t kExpectedSSP=0x00086FC0;
+static constexpr uint32_t kExpectedEvtB4=0xC003B400;
+using WriteFn=void (*)(void *,unsigned long,uint32_t);
+using ReadFn=uint32_t (*)(void *,unsigned long);
+
+static bool upload(void *controller,uintptr_t writeAddress,uintptr_t readAddress,uint32_t *verify) {
+    if (!controller || !writeAddress || !readAddress) return false;
+    if (SL4TGLDMC::kProgramDwords!=4460 ||
+        SL4TGLDMC::kProgram[0]!=kExpectedFirst ||
+        SL4TGLDMC::kLoadAddress!=0x80000 ||
+        SL4TGLDMC::kMmioWriteCount!=9 ||
+        SL4TGLDMC::kMmioWrites[0].addr!=0x8F074 ||
+        SL4TGLDMC::kMmioWrites[0].data!=kExpectedSSP ||
+        SL4TGLDMC::kMmioWrites[1].data!=kExpectedEvtB4)
+        return false;
+    void *mgr=*reinterpret_cast<void **>(
+        reinterpret_cast<uint8_t *>(controller)+kManagerOffset);
+    if (!mgr) return false;
+    auto wr=reinterpret_cast<WriteFn>(writeAddress);
+    auto rd=reinterpret_cast<ReadFn>(readAddress);
+    // The framebuffer has already configured the display/clock powers
+    // through the original donor. We replace ONLY its DMC program.
+    for (uint32_t i=0;i<SL4TGLDMC::kProgramDwords;i++) {
+        wr(mgr,static_cast<unsigned long>(SL4TGLDMC::kLoadAddress)+4UL*i,
+           SL4TGLDMC::kProgram[i]);
+    }
+    for(uint32_t i=0;i<SL4TGLDMC::kMmioWriteCount;i++) {
+        uint32_t value=SL4TGLDMC::kMmioWrites[i].data;
+        // Validated TGL i915 DMC event correction: VBLANK_A (0x32)
+        // must be delayed-VBLANK_A (0x2e) for the HRR handler.
+        if(SL4TGLDMC::kMmioWrites[i].addr==0x8F03C &&
+           value==0xC0033200)
+            value=0xC0032E00;
+        wr(mgr,SL4TGLDMC::kMmioWrites[i].addr,value);
+    }
+    const uint32_t back=rd(mgr,0x80000);
+    if (verify)*verify=back;
+    return back==kExpectedFirst;
+}
+}
