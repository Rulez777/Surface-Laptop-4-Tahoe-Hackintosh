+// -wex-tgl-gpurec / -wex-tgl-stampfix: render reset-domain recovery for the
+// exact AppleIntelTGLGraphics 16.0.32 donor. Port of NootedGreen XE-GPUREC
+// v1+v2 and XE-STAMPFIX (JulioNectar XPS13Plus kern_gen11.cpp 12109-12354;
+// NP550XDA kern_gen11.cpp 13298-13345, 14521-14606).
+//  - IGHardwareRingBuffer::resetGraphicsEngine (0x43576) saves ring+0x78
+//    (IGVector<resetRegisterInfo>, 0x24-byte entries), writes GDRST 0x941C =
+//    ring+0x70 (0x43769), restores that list with getDefaultResetValue
+//    (0x2E60A) or the saved value (masked | 0xFFFF0000), then replays only its
+//    own engine: scheduler vtable+0x190 (0x4385B) -> IGScheduler5::
+//    processGPUReset (0x380D8) -> IGHardwareCommandStreamer5::processGPUReset
+//    (0x3A396). RCS (_rcsResetRegisters 0x14B2B0) and CCS (_ccsResetRegisters
+//    0x14AEB8) share GDRST bit 1, so a reset of either leaves the other at
+//    hardware defaults (RCS GFX_MODE 0, FORCE_TO_NONPRIV0 0xE000).
+//  - IntelAccelerator::initModeRegisters (0x28E7E) programs RCU_MODE 0x14800
+//    bit 0 = (accel+0x1190 >> 33) & 1 (CCS enable) and CCS FORCE_TO_NONPRIV0
+//    0x1A4D0 (0x28F27) only at engine start; no reset list restores them.
+//  - IGAccelEventMachine::eventTimeout (0x15F22) maps a stamp index to an
+//    engine through IG_STAMP_INDEX_TO_HWCS_LUT (0xA0290; _SCI 0xA0280). It
+//    returns NULL (no channel, nothing restarted) for reason 1 (display stamp
+//    range), 2 (accel+0x1190 & 0x20, 0x15F55), 3 (checkForProgress), 4 (no
+//    active context: halt/resume, 0x16076..0x160A1) and 5 (another context
+//    active, under the time threshold: 0x160A3..0x16101). Reason 6 (the
+//    active context owns the stamp, or the threshold passed) calls
+//    prepareGPUReset and returns the channel for a real restart (0x16120).
+//  - -wex-tgl-stampfix acts ONLY on a NULL return. It never touches reason 6,
+//    so it does not stop a loop of real restarts: repeated restarts of one
+//    context (a reset that does not clear the hang) are outside its reach.
+#ifndef kern_tgl_gpurec_hpp
+#define kern_tgl_gpurec_hpp
+#include <stdint.h>
+#include <string.h>
+
+namespace TGLGpuRec {
+constexpr unsigned EntrySize=0x24, MaxEntries=64, Stamps=64, StampStride=16;
+constexpr uint32_t FirstRegister[2] {0x2080,0x1A080};   // HWS_PGA heads both native lists
+constexpr uint32_t Extras[5] {0x14800,0xCE90,0x1A4D0,0x1A0A8,0x1A098};
+constexpr bool ExtrasMasked[5] {true,true,false,false,false};
+// TGLGpuRecLive = {LiveRevision, Flag bits, counts[Slots]}. Revision 1 ended
+// at WhitelistFixes (14 slots); revision 2 appends after it. Decoders index by
+// position: never reorder, only insert before Slots and bump the revision.
+constexpr uint32_t LiveRevision=2;
+enum Flag : uint32_t {RegistersFlag=1,StampsFlag=2,HaltFlag=4,WithPOSHFlag=8};
+enum Count : unsigned {
+ Resets,          // qualified render-domain resets seen by the route
+ SiblingRestores, // sibling list rewritten after GDRST wiped its HWS_PGA
+ SiblingReplays,  // IGScheduler5::processGPUReset calls for the sibling: CALLS,
+                  // not resubmits (see SiblingResubmits)
+ OwnFixes,KickSkips,
+ ExtrasFixes,     // fix-up passes that wrote RCU_MODE or a CCS extra
+ LastRCU,         // RCU_MODE after the last fix-up pass (post-fix value)
+ Last,            // own | ok<<4 | kick<<5 | did<<8 (1 sibling restore, 2 own
+                  // fix, 4 sibling replay, 8 extras/whitelist rewritten) |
+                  // sibling HWS_PGA snapshot & 0xFFFFF000
+ SiblingNotReady,ListInvalid,StampFixes,StampLast,StampDeclined,
+ WhitelistFixes,  // passes that rewrote an RCS FORCE_TO_NONPRIV constant
+ // Revision 2.
+ PreFixRCU,       // RCU_MODE between GDRST and the own replay, before any fix:
+                  // with the CCS enabled at start, bit 0 clear here means the
+                  // GDRST cleared the CCS enable
+ PreFixReads,     // number of PreFixRCU samples (0: PreFixRCU never written)
+ PocsBefore,PocsAfter,       // 0x18080 around the native reset (read-only)
+ Pocs88Before,Pocs88After,   // 0x18088 around the native reset (read-only)
+ SiblingResubmits, // sibling replays whose streamer had an active execlist
+                   // element, so the native beginReset/resubmit actually ran
+ SiblingHalts,    // -wex-tgl-gpurec-halt: native haltCommandStreamer(sibling)
+ HaltNotReady,    // halt returned without READY_TO_RESET (its poll timed out)
+ SiblingResumes,  // REQUEST_RESET survived the native reset: native resume
+ Slots
+};
+// Read-only POCS observation; never written (its full register set is
+// unknown). 0x18080 is the POCS HWS_PGA (initHardwareStatusPageRegisters
+// 0x28FB8); startGraphicsEngine writes 0x18088=0x80008 (0x252E9). Neither is
+// in a native reset list.
+constexpr uint32_t Pocs[2] {0x18080,0x18088};
+
+struct List {uint64_t count; const uint8_t *data;};
+// IGVector layout: {u64 count; u64 capacity; resetRegisterInfo *data}.
+inline bool list(const void *vector,unsigned engine,List &out) {
+ if(!vector || engine>1)return false;
+ auto v=static_cast<const uint8_t *>(vector);
+ memcpy(&out.count,v,8);memcpy(&out.data,v+0x10,8);
+ uint32_t first=0;
+ if(!out.data || !out.count || out.count>MaxEntries)return false;
+ memcpy(&first,out.data,4);
+ return first==FirstRegister[engine];
+}
+inline uint32_t reg(const List &l,uint64_t i) {uint32_t r;memcpy(&r,l.data+i*EntrySize,4);return r;}
+inline bool masked(const List &l,uint64_t i) {return l.data[i*EntrySize+8]!=0;}
+// Same value rule as the native restore loop after GDRST.
+inline uint32_t restoreValue(uint32_t nativeDefault,uint32_t saved,bool isMasked) {
+ uint32_t v=nativeDefault?nativeDefault:saved;
+ return isMasked?(v|0xFFFF0000U):v;
+}
+// The native restore loop (0x437FA..0x43840) over one list. nativeDefault(r)
+// is getDefaultResetValue, write(r,v) the MMIO store.
+template<class Default,class Write>
+inline void writeList(const List &l,const uint32_t *saved,Default nativeDefault,Write write) {
+ for(uint64_t i=0;i<l.count;++i) {
+  const uint32_t r=reg(l,i);
+  write(r,restoreValue(nativeDefault(r),saved[i],masked(l,i)));
+ }
+}
+inline uint32_t ccsEnabled(uint64_t features) {return static_cast<uint32_t>((features>>33)&1);}
+// Writes needed after a render-domain reset. Bit n selects Extras[n].
+inline uint32_t plan(const uint32_t live[5],const uint32_t *good,uint32_t ccsOn,uint32_t value[5]) {
+ uint32_t mask=0;
+ if((live[0]&1)!=ccsOn) {value[0]=0x10000U|ccsOn;mask|=1;}   // initModeRegisters' masked bit 0
+ // initModeRegisters writes 0xCE90 and the CCS registers only with CCS on
+ // (je 0x28EBA after the RCU store); leave them alone otherwise.
+ if(good && ccsOn)for(unsigned i=1;i<5;++i) {
+  const bool same=ExtrasMasked[i]?((live[i]&0xFFFF)==(good[i]&0xFFFF)):(live[i]==good[i]);
+  if(same)continue;
+  value[i]=ExtrasMasked[i]?(0xFFFF0000U|(good[i]&0xFFFF)):good[i];mask|=1U<<i;
+ }
+ return mask;
+}
+// A snapshot is trusted only while RCU_MODE still matches the start-up value.
+inline bool healthy(const uint32_t live[5],uint32_t ccsOn) {return (live[0]&1)==ccsOn;}
+
+// RCS FORCE_TO_NONPRIV 0x24D0..0x24FC are in _rcsResetRegisters (rcsRegisters
+// 0xC2200) but not in populateResetRegisterList's default list (acc+0x12C0),
+// so the native restore writes back the pre-reset value: once a sibling reset
+// has wiped them (0xE000 seen in a 9A49 gpuRestart report after an own RCS
+// reset), they stay wiped. initModeRegisters programs these constants
+// (0x28EC3..0x28F1D) when accel+0x1191 bit 0 is set; the last two also need
+// bit 25 of accel+0xFE6.
+struct Pair {uint32_t reg,value;};
+constexpr Pair Whitelist[9] {{0x24D0,0xE100},{0x24D4,0x7010},{0x24D8,0xB134},{0x24DC,0x7008},{0x24E0,0x2580},
+ {0x24F0,0x731C},{0x24F4,0x2244},{0x24F8,0x10002351},{0x24FC,0x10002341}};
+// Bit n selects Whitelist[n] for a rewrite.
+inline uint32_t whitelistPlan(const uint32_t live[9],bool programmed,bool optional) {
+ uint32_t mask=0;
+ if(!programmed)return 0;
+ for(unsigned i=0;i<9;++i) {
+  if(i>=7 && !optional)break;
+  if(live[i]!=Whitelist[i].value)mask|=1U<<i;
+ }
+ return mask;
+}
+// Read the whitelist, rewrite what differs; returns the whitelistPlan mask.
+template<class Read,class Write>
+inline uint32_t fixWhitelist(Read read,Write write,bool programmed,bool optional) {
+ uint32_t live[9];
+ for(unsigned i=0;i<9;++i)live[i]=read(Whitelist[i].reg);
+ const uint32_t rewrite=whitelistPlan(live,programmed,optional);
+ for(unsigned i=0;i<9;++i)if(rewrite&(1U<<i))write(Whitelist[i].reg,Whitelist[i].value);
+ return rewrite;
+}
+// List restore after the native reset. FORCE_TO_NONPRIV has no native
+// default, so a list write stores whatever the snapshot held (0xE000 once an
+// earlier sibling reset wiped it) and would undo an earlier whitelist fix-up.
+// The whitelist is therefore re-applied after every list write: it is always
+// the last writer. Returns the whitelist rewrite mask.
+template<class Default,class Read,class Write>
+inline uint32_t restoreList(const List &l,const uint32_t *saved,Default nativeDefault,Read read,Write write,
+                            bool programmed,bool optional) {
+ writeList(l,saved,nativeDefault,write);
+ (void)read(reg(l,0)); // posting read
+ return fixWhitelist(read,write,programmed,optional);
+}
+
+// IGHardwareCommandStreamer5::processGPUReset (0x3A396) loads the active
+// execlist element [this+0x30+16*port], port = u32 this+0x50 (0 or 1); when it
+// is NULL the je at 0x3A3C8 goes to the epilogue (0x3A52B) with no
+// beginReset/resubmission (the CSB head was already rewritten before that).
+constexpr unsigned StreamerPort=0x50, StreamerElements=0x30, ElementStride=16;
+inline bool activeElement(const uint8_t *streamer) {
+ if(!streamer)return false;
+ uint32_t port;memcpy(&port,streamer+StreamerPort,sizeof(port));
+ if(port>1)return false;
+ const void *element;memcpy(&element,streamer+StreamerElements+port*ElementStride,sizeof(element));
+ return element!=nullptr;
+}
+
+// -wex-tgl-gpurec-halt. IGScheduler::haltCommandStreamer(IGHwCsType) (0x56978)
+// stores RING_RESET_CTL (kIGHwCsDesc+0x3D: RCS 0x20D0, CCS 0x1A0D0) = masked
+// REQUEST_RESET and polls READY_TO_RESET (bit 1), at most 10000 times, with
+// assert_wait_timeout/thread_block like the GDRST poll in resetGraphicsEngine.
+// resumeCommandStreamer (0x56A2E) stores the masked clear and polls the same
+// way. The only native halt call (eventTimeout 0x1603C) stops the engine
+// whose stamp timed out; the other engine of the render domain keeps running
+// into the GDRST.
+constexpr uint32_t ResetControl[2] {0x20D0,0x1A0D0};
+constexpr uint32_t RequestReset=1, ReadyToReset=2;
+// Halt only ahead of the plain GDRST path (no ring-kick engine flags) and only
+// an engine that start-up enabled.
+inline bool haltWanted(bool enabled,bool kick,bool siblingInUse) {return enabled && !kick && siblingInUse;}
+inline bool haltReady(uint32_t control) {return control!=0xFFFFFFFFU && (control&ReadyToReset);}
+// GDRST resets the sibling's RESET_CTL with the rest of the render domain; a
+// request that is still set afterwards needs the native resume.
+inline bool resumeWanted(uint32_t control) {return control!=0xFFFFFFFFU && (control&RequestReset);}
+
+// Orphan stamp completion. Called only after eventTimeout returned NULL; a
+// returned channel (reason 6, real restart) only resets the strike count.
+struct StampState {uint32_t value[Stamps]; uint8_t strikes[Stamps];};
+inline void forget(StampState &s,unsigned i) {if(i<Stamps)s.strikes[i]=0;}
+// true: write returned=submitted and signal. Only an idle engine qualifies
+// (getActiveContexts finds none, as in native reason 4, 0x16076..0x160A1):
+// the second consecutive NULL timeout of the same submitted value completes
+// it. An engine with an active context (native reason 5) never completes and
+// resets the count: that work may be legitimately queued behind a long job.
+// Seen on hardware: after a -wex-tgl-gpurec recovery the hung client's stamp
+// never retired, so killing that client blocked IOServiceTerminateThread in
+// commandQueueStop -> finishEvent -> eventTimeout -> checkForProgress forever.
+// The display stamp range (reason 1) never completes.
+inline bool complete(StampState &s,unsigned i,uint32_t returned,uint32_t submitted,bool display,bool engineActive) {
+ if(i>=Stamps || display)return false;
+ if(engineActive || returned==submitted || static_cast<int32_t>(submitted-returned)<0) {forget(s,i);return false;}
+ if(s.value[i]!=submitted) {s.value[i]=submitted;s.strikes[i]=0;}
+ if(s.strikes[i]<255)++s.strikes[i];
+ const bool done=s.strikes[i]>=2;
+ if(done)forget(s,i);
+ return done;
+}
+}
+#endif
diff --git a/WhateverXe/kern_tgl_nomc.hpp b/WhateverXe/kern_tgl_nomc.hpp
new file mode 100644
index 0000000..9d612c1
--- /dev/null
+++ b/WhateverXe/kern_tgl_nomc.hpp
@@ -0,0 +1,47 @@
+// -wex-tgl-nomc: run the exact AppleIntelTGLGraphics 16.0.32 donor without
+// multi-context, i.e. without the CCS (compute work then shares the RCS).
+// Fallback for render-domain recovery: a CCS hang can no longer reset the RCS
+// and RCU_MODE can never be left half-enabled. Port of NootedGreen NP550XDA
+// -ngreennomc (kern_gen11.cpp 2486-2497). Two exact-offset sites; every site
+// is byte-checked before any is patched and re-checked afterwards:
+//  - 0x27499, IntelAccelerator::populateAccelConfig (0x270E8)+0x3B1, right
+//    after utilGetProperty("EnableMultiContext") (0x27494): `and eax,ebx`
+//    becomes `xor eax,eax`, so accel+0x1190 bit 33 (CCS enable, also read by
+//    initModeRegisters for RCU_MODE bit 0) is stored as 0.
+//  - 0x4BF0A, IntelTGLMemoryManager::newUnifiedAddressRangeAllocator
+//    (0x4BED8)+0x32: the `je` after `test byte [accel+0x1194],2` (the same
+//    bit 33) becomes two NOPs, so the high-range reservation (reserveRange
+//    0xFFFF800000000000, size 0x800000000000 at 0x4BF34) stays as with the
+//    CCS on. Native EnableMultiContext=0 skips it; keeping it follows NP550XDA
+//    and is not proven necessary.
+// Both patterns occur exactly once in the donor binary.
+#ifndef kern_tgl_nomc_hpp
+#define kern_tgl_nomc_hpp
+#include <stddef.h>
+#include <stdint.h>
+#include <string.h>
+
+namespace TGLNoMC {
+constexpr size_t MaxLength=16;
+struct Site {uint32_t offset; uint8_t length; uint8_t find[MaxLength]; uint8_t replace[MaxLength];};
+constexpr Site Sites[2] {
+ {0x27499,16,{0x21,0xD8,0x48,0xC1,0xE0,0x21,0x48,0xB9,0xFF,0xFF,0xFF,0xFF,0xFD,0xFF,0xFF,0xFF},
+             {0x31,0xC0,0x48,0xC1,0xE0,0x21,0x48,0xB9,0xFF,0xFF,0xFF,0xFF,0xFD,0xFF,0xFF,0xFF}},
+ {0x4BF0A,14,{0xF6,0x80,0x94,0x11,0x00,0x00,0x02,0x74,0x26,0x41,0xF6,0x46,0x24,0x02},
+             {0xF6,0x80,0x94,0x11,0x00,0x00,0x02,0x90,0x90,0x41,0xF6,0x46,0x24,0x02}},
+};
+constexpr size_t End=0x4BF0A+14; // one past the last checked byte
+enum State : unsigned {Unknown,Original,Patched};
+// Original: every site holds its native bytes; Patched: every site holds its
+// replacement. Anything else (a partial or foreign edit) is Unknown.
+inline State state(const uint8_t *base,size_t size) {
+ if(!base || size<End)return Unknown;
+ bool original=true,patched=true;
+ for(const auto &s:Sites) {
+  original=original && !memcmp(base+s.offset,s.find,s.length);
+  patched=patched && !memcmp(base+s.offset,s.replace,s.length);
+ }
+ return original?Original:patched?Patched:Unknown;
+}
+}
+#endif
diff --git a/WhateverXe/kern_tgl_noposh.hpp b/WhateverXe/kern_tgl_noposh.hpp
new file mode 100644
index 0000000..ab97280
--- /dev/null
+++ b/WhateverXe/kern_tgl_noposh.hpp
@@ -0,0 +1,66 @@
+// -wex-tgl-no-posh: Tiger Lake RCS contexts without POSH (position-only
+// shading on the POCS engine). Exact AppleIntelTGLGraphics 16.0.32 donor:
+//  - IGHardwareContext flags byte +0x6E bit 0x10 marks a POSH context.
+//    initWithOptions tests it at 0x7BB13 (allocates the 16 KiB POCS image at
+//    +0xA0), restoreFromSafeImage at 0x7C421 (copies the POCS safe image) and
+//    submitBatchBuffer at 0x43021 (MI_BATCH_BUFFER_START bit 20).
+//  - g_cInitGfxHwCtxParamsForGraphics (0xB09A4 startup, 0xB0BC0 command
+//    queues) is {0,0,0x1C,...}: every graphics context and both safe-image
+//    source contexts made by startGraphicsEngine are POSH contexts.
+//  - LRC page 1 (g_cInitGfxRingContextRCS, 0xC04A0): CTX_CTRL 0x2244 at
+//    +0x1008/+0x100C and POSH_LRCA 0x21B0 at +0x10D4/+0x10D8.
+//  - The clone branch of initWithOptions (0x7C169..0x7C17A) gives a non-POSH
+//    context CTX_CTRL=(v&0xFFEFFFEF)|0x00100000. beginReset (0x7C919) calls
+//    restoreFromSafeImage without that fix-up, so a GPU reset restores the
+//    safe image's POSH control bit and POSH_LRCA (the released startup
+//    context's POCS image) into every RCS context it replays.
+// Clearing the flag before the native copy, then applying the same fix-up
+// plus POSH_LRCA=0 after every successful copy, gives each RCS context the
+// non-POSH image that the native clone branch builds. Port of NootedGreen
+// xe/noposh (NP550XDA kern_gen11.cpp 14927-14946, default since 2026-11-03).
+#ifndef kern_tgl_noposh_hpp
+#define kern_tgl_noposh_hpp
+#include <stdint.h>
+
+namespace TGLNoPOSH {
+constexpr unsigned EngineOffset=0x6C, FlagsOffset=0x6E;
+constexpr uint8_t POSHFlag=0x10;
+constexpr uint32_t ControlRegister=0x2244, ControlRegisterOffset=0x1008, ControlOffset=0x100C;
+constexpr uint32_t LRCARegister=0x21B0, LRCARegisterOffset=0x10D4, LRCAOffset=0x10D8;
+// Masked register: bit 20 enables the write of bit 4 (POSH enable).
+constexpr uint32_t ControlKeep=0xFFEFFFEFU, ControlMaskBit4=0x00100000U;
+enum Count : unsigned {
+ Calls,          // RCS restoreFromSafeImage calls seen while enabled
+ FlagCleared,    // POSH flag found set and cleared before the native copy
+ RestoreFalse,   // native copy declined (no safe image yet: startup contexts)
+ InitSanitized,  // successful copies from initWithOptions (return 0x7C131)
+ ResetSanitized, // successful copies from beginReset (return 0x7C91E) or others
+ LRCAZeroed,     // POSH_LRCA was non-zero and was cleared
+ ControlCleared, // CTX_CTRL bit 4 was set and was cleared
+ LayoutMismatch, // register identities differ: nothing written
+ Slots
+};
+enum Result : uint32_t {ZeroedLRCA=1,ClearedControl=2,ChangedControl=4,Mismatch=0x80000000U};
+
+// RCS only. True when the POSH flag was set and is now clear.
+inline bool clearFlag(uint8_t *context) {
+ if(!context || context[EngineOffset]!=0 || !(context[FlagsOffset]&POSHFlag))return false;
+ context[FlagsOffset]=static_cast<uint8_t>(context[FlagsOffset]&~POSHFlag);
+ return true;
+}
+
+// Rewrite an LRC image whose page 1 holds the native RCS register layout.
+// No write at all unless both register identities match.
+inline uint32_t sanitize(uint8_t *image,uint64_t length) {
+ if(!image || length<LRCAOffset+4)return Mismatch;
+ auto word=[image](uint32_t offset)->uint32_t & {return *reinterpret_cast<uint32_t *>(image+offset);};
+ if(word(ControlRegisterOffset)!=ControlRegister || word(LRCARegisterOffset)!=LRCARegister)return Mismatch;
+ uint32_t result=0;
+ if(word(LRCAOffset)) {word(LRCAOffset)=0;result|=ZeroedLRCA;}
+ const uint32_t control=word(ControlOffset),fixed=(control&ControlKeep)|ControlMaskBit4;
+ if(control&0x10U)result|=ClearedControl;
+ if(fixed!=control) {word(ControlOffset)=fixed;result|=ChangedControl;}
+ return result;
+}
+}
+#endif
diff --git a/WhateverXe/kern_va_fix.hpp b/WhateverXe/kern_va_fix.hpp
new file mode 100644
index 0000000..12496a3
--- /dev/null
+++ b/WhateverXe/kern_va_fix.hpp
@@ -0,0 +1,395 @@
+// Page-in edits applied by the cs_validate patcher (kern_xe.cpp, pageIn*),
+// which -wex-mtl-poshfix also uses.
+//
+// PageFix is the generic part: an anchor is one window of a signed binary,
+// pinned to its file offset, holding the exact original bytes and their
+// replacement. Anchors are at least 32 bytes and lie inside one 4 KB page, so
+// a validated page either holds a whole anchor or none of it.
+//
+// VAFix targets the Tiger Lake VA plug-in AppleIntelTGLGraphicsVADriver
+// 16.0.32 as shipped in the WhateverXe Graphics package (file sha256
+// a972cdb7...726d, thin x86_64, __TEXT file offset == vmaddr). Every VAFix
+// anchor occurs exactly once in that file and in no other binary of the
+// package (Metal bundle, libigdmd, TGLVA, accelerator, framebuffer, Compat).
+// Nothing on disk changes.
+//
+// -wex-va-nullguard. Apple's VphalRendererG12::AllocateRenderComponents
+// (0x1b1bc0) allocates only pRender[COMPOSITE] (+0x920); pRender[VEBOX] and
+// pRender[VEBOX2] (+0x910, +0x918) stay NULL for the renderer's lifetime
+// (zeroed at 0x132df4/0x132dff, never assigned). The package already skips
+// their Initialize calls (caves 0xd80/0xd98). Three uses remain unguarded:
+//   N1 0x1336f3  status-block hookup, pRender[VEBOX]->+8 = &renderer->+0x2cb0
+//                (the reported crash, VTPixelTransferSession prepare step)
+//   N2 0x130e91  render preparation, SetStatusReportParams(pRender[VEBOX+ch])
+//                (0x126520 writes +0x48..+0x58 of the NULL slot)
+//   N3 0x12d316  VEBOX render step, virtual call on pRender[VEBOX+ch] that
+//                precedes the function's own NULL check (0x12d32b -> status 5)
+// A NOP at N1 alone only moves the crash to N2 on the following transfer.
+// Each site instead gets an in-place test of the loaded pointer, in the same
+// bytes: when it is non-NULL the same loads, store or call happen with the
+// same values and the calls keep their addresses and bytes (only scratch
+// registers that are dead afterwards differ); when it is NULL, N1/N2 skip only
+// the store or call on that slot and N3 jumps to the function's existing NULL
+// path (clear bOutputGenerated, return MOS_STATUS_NULL_POINTER). No execution
+// that does not fault today behaves differently. The three anchors are
+// independent. No function involved has an exception landing pad, and no
+// branch lands inside a rewritten span.
+//
+// -wex-va-vfeg12 (hypothesis test: Gen12 MEDIA_VFE_STATE and L3 for the
+// MediaKernelContext VFE builder 0x2c84a, a virtual method). Eight sites on
+// two pages, one anchor per page, so a page is edited completely or not at
+// all:
+//   V1 0x1000   LRI helper 0x1c1b, whose only caller is the builder (0x2c8fc):
+//               {reg 0x0, 0x80000040} -> {L3ALLOC 0xB134, 0xD0000020}
+//   V2 0x2c000  the builder from that call to its loop exit (0x2ca67): every
+//               MEDIA_VFE_STATE it emits gets DW3 bit 6 = 1 (legacy dispatch,
+//               as Intel's Gen12 media driver programs it) and DW6..DW8 = 0
+//               (reserved on Gen12), on both copy paths
+// The builder copies the 36-byte MEDIA_VFE_STATE template 0x31d720 (DW0
+// 0x70000007, DW3 0, DW6..DW8 0x000000ff 0xfff1f00f 0xefe1e01f), then
+// rewrites DW3 (bits 8-15 = 0x10, bits 16-31 = threads - 1), DW5 and, by
+// byte [this+0x124]:
+//   path A (!= 0): DW6..DW8 zeroed by the code (0x2c9d3/0x2c9db), then a
+//                  per-entry scoreboard store (dword [this+0x41cc+4i]: type 2
+//                  DW6:DW7 = 0x80000001:0xf0, type 1 0x80000001:0x0f)
+//   path B (== 0): DW6..DW8 kept from the template, DW6 bit 31 set
+// The template itself is NOT edited: a second builder family (0x17a7f, lea
+// at 0x17ad5; callers 0x188a9, 0x1912e, 0x19f98, 0x1a760, 0x1cc7b) copies it
+// too, keeps DW3 bits 0-7, ORs scoreboard bits 31/30 into DW6 and has its own
+// LRI helper (0x17a60), so a template edit would put that family in a state
+// that is neither stock nor the hypothesis. The builder's own copy path is
+// edited instead:
+//   0x2c9ae, 0x2ca22  DW3 `or 0x1000` -> `or 0x1040` (paths A, B); bits 0-15
+//                     survive the movzx/lea that then adds the thread count
+//   0x2ca03           path B DW8 load `mov edx,[rax+0x20]` -> `xor edx,edx; nop`
+//   0x2ca08           path B DW6:DW7 load `mov rdx,[rax+0x18]` ->
+//                     `xor edx,edx; xchg ax,ax` (rdx = 0, flags dead)
+//   0x2ca47           path B `or byte [rdi-5],0x80` (DW6 bit 31) -> 4-byte NOP
+//   0x2ca4d, 0x2ca53  path A scoreboard stores `mov [rdi-8],r10/r11` -> NOPs
+// Instruction boundaries and every branch target (0x2c977, 0x2c9f8, 0x2ca4d,
+// 0x2ca53, 0x2ca57) are kept; the builder has no landing pad. On every path
+// the emitted state equals what the earlier three-page set (template edit)
+// produced for this builder, and nothing outside pages 0x1000 and 0x2c000
+// changes.
+// Pages are validated independently and in any order, so the set uses a
+// latch (PageFix::decide/commit/poison): the first pinned hit of any member
+// decides once for the boot (Armed or Off) and every later page of the set,
+// including a page validated again after eviction, follows that decision.
+// The builder calls the V1 helper on every batch (the call is inside the V2
+// anchor), so both pages have passed validation, under the same decision,
+// before a MEDIA_VFE_STATE is emitted.
+// L3: V1 programs L3ALLOC 0xB134 only; Intel's Gen12 SetL3Cache also writes
+// TCCNTLREG 0xB138 = 0, which V1 does not. The LRI runs from the VA driver's
+// (non-privileged) batch, so it relies on the RCS FORCE_TO_NONPRIV entry
+// 0x24D8 = 0xB134. The accelerator programs that list only when accel+0x1191
+// bit 0 is set: IntelAccelerator::initModeRegisters 0x28EBA `test byte
+// [rdi+0x1191],1; je 0x28F31` skips all of RCS 0x24D0..0x24FC and CCS
+// 0x1A4D0 (-wex-tgl-gpurec restores the list under the same bit). The VFEG12
+// gate does not check this bit; WEXVAFix publishes it (ready bits
+// L3WhitelistSampled/L3Whitelisted, sampled when IntelAccelerator::start
+// returns true while -wex-va-vfeg12 is given).
+// An anchor found away from its file offset is only counted (nothing is
+// written there, the latch is untouched).
+// A write that fails before any member window was written poisons the set
+// (no writes this boot); after the first member write the set is committed,
+// a failure is counted and that page is edited at its next validation, so a
+// poison can never leave an edited set split. Pages already edited cannot be
+// reverted from the page-in hook.
+#ifndef kern_va_fix_hpp
+#define kern_va_fix_hpp
+#include <stddef.h>
+#include <stdint.h>
+#include <string.h>
+
+namespace PageFix {
+constexpr size_t PageSize=0x1000;
+// One window of a signed binary, pinned to its file offset. `from` is the
+// exact original content and `to` the replacement of the same length; only
+// differing bytes are written. `sites` counts the spec sites inside.
+struct Anchor {
+    uint64_t fileOffset;
+    const uint8_t *from,*to;
+    uint16_t length;
+    uint8_t sites;
+};
+inline bool matches(const Anchor &a,const uint8_t *at) {
+    return at && !memcmp(at,a.from,a.length);
+}
+// Edit a window in place. A window that already holds `to` is done without a
+// write: scan() matches `from` outside the kernel write lock, so a racing
+// validation of the same page may have edited it in between. Otherwise
+// nothing is written unless the whole window holds `from`; afterwards the
+// whole window must hold `to`.
+inline bool apply(const Anchor &a,uint8_t *at) {
+    if(!at)return false;
+    if(!memcmp(at,a.to,a.length))return true;
+    if(!matches(a,at))return false;
+    for(size_t i=0;i<a.length;++i) if(at[i]!=a.to[i])at[i]=a.to[i];
+    return !memcmp(at,a.to,a.length);
+}
+// First byte equal to c in [p, p+n), or NULL; memchr semantics. A local loop
+// on purpose: Lilu's lilu_os_memchr only exists from Lilu 1.5.1, and the kext
+// declares an older Lilu (tools/build.py), so using it would add a link
+// dependency even with every switch off.
+inline void *findByte(const void *p,int c,size_t n) {
+    auto b=static_cast<const uint8_t *>(p);
+    const auto key=static_cast<uint8_t>(c);
+    for(size_t i=0;i<n;++i) if(b[i]==key)return const_cast<uint8_t *>(b+i);
+    return nullptr;
+}
+// Call f(index, at, pinned) for every window of [data, data+size) equal to
+// anchors[index].from. rangeOffset is the file offset of data[0]; pinned is
+// true when the window starts at the anchor's own file offset. chr is the
+// byte search (findByte in the kext). One search pass per distinct first
+// byte; anchors sharing a first byte share the pass.
+template<class Chr,class F> size_t scan(const Anchor *anchors,size_t count,const uint8_t *data,uint64_t size,uint64_t rangeOffset,Chr chr,F f) {
+    size_t hits=0;
+    if(!data)return 0;
+    for(size_t i=0;i<count;++i) {
+        const uint8_t key=anchors[i].from[0];
+        bool shared=false;
+        for(size_t j=0;j<i;++j)shared=shared || anchors[j].from[0]==key;
+        if(shared)continue;
+        for(uint64_t o=0;o<size;++o) {
+            auto p=static_cast<const uint8_t *>(chr(data+o,key,static_cast<size_t>(size-o)));
+            if(!p)break;
+            o=static_cast<uint64_t>(p-data);
+            for(size_t j=i;j<count;++j) {
+                const Anchor &a=anchors[j];
+                if(a.from[0]!=key || size-o<a.length || !matches(a,p))continue;
+                ++hits;
+                f(j,const_cast<uint8_t *>(p),rangeOffset+o==a.fileOffset);
+            }
+        }
+    }
+    return hits;
+}
+// Latch for a set of anchors on different pages that must agree, all or
+// none. Undecided -> Armed | Off at the first pinned hit (decide). Armed ->
+// Committed before the first member byte is written (commit), Armed ->
+// Poisoned when a member write fails before any member byte was written
+// (poison). Off, Poisoned and Committed are final.
+//   Armed      decided to edit, no member window written yet
+//   Committed  a member window has been written: every later page of the set,
+//              including one validated again after eviction, is edited too
+//   Off        decided not to edit (gate closed at the first hit)
+//   Poisoned   a write failed before anything was written: nothing is ever
+//              written for the set this boot
+// An unpinned hit never changes the latch: it writes nothing, so stopping the
+// set for it protects nothing, and after Committed it would split the set
+// (pages still resident stay edited, pages read back from disk would not).
+enum : uint32_t {Undecided=0,Armed=1,Off=2,Poisoned=3,Committed=4};
+inline uint32_t decide(uint32_t *latch,bool gate) {
+    uint32_t expected=Undecided;
+    __atomic_compare_exchange_n(latch,&expected,gate?Armed:Off,false,__ATOMIC_ACQ_REL,__ATOMIC_ACQUIRE);
+    return __atomic_load_n(latch,__ATOMIC_ACQUIRE);
+}
+// A member write failed with nothing written: poisons the set only while no
+// member window has been written (Armed). Once Committed the decision stands
+// (the failure is only counted and the page is edited at its next
+// validation), so a poison can never split an edited set.
+inline void poison(uint32_t *latch) {
+    uint32_t expected=Armed;
+    __atomic_compare_exchange_n(latch,&expected,Poisoned,false,__ATOMIC_ACQ_REL,__ATOMIC_ACQUIRE);
+}
+// Before writing a member window: Armed -> Committed. False when the set was
+// poisoned meanwhile (write nothing).
+inline bool commit(uint32_t *latch) {
+    uint32_t expected=Armed;
+    __atomic_compare_exchange_n(latch,&expected,Committed,false,__ATOMIC_ACQ_REL,__ATOMIC_ACQUIRE);
+    return __atomic_load_n(latch,__ATOMIC_ACQUIRE)==Committed;
+}
+enum class Action : uint8_t {Patch,SkipGate,SkipOffset};
+// Independent anchors: edit only at the pinned offset.
+inline Action single(bool pinned) {return pinned?Action::Patch:Action::SkipOffset;}
+// Member of a latched set: an unpinned hit is skipped (the caller counts it)
+// and leaves the latch alone; a pinned hit decides once from the gate and
+// every later hit follows.
+inline Action member(uint32_t *latch,bool gate,bool pinned) {
+    if(!pinned)return Action::SkipOffset;
+    const uint32_t state=decide(latch,gate);
+    return state==Armed || state==Committed?Action::Patch:Action::SkipGate;
+}
+enum class Write : uint8_t {Done,Skipped,Failed};
+// Edit one member window after member() said Patch, with the kernel write
+// window open. Already edited (a racing validation): Done, no write. A window
+// that holds neither `from` nor `to` is a failure with nothing written:
+// poison(). Otherwise commit() first (Skipped, nothing written, if the set was
+// poisoned meanwhile), then write and verify; a verify failure after commit
+// is only reported (Failed).
+inline Write applyMember(uint32_t *latch,const Anchor &a,uint8_t *at) {
+    if(!at)return Write::Failed;
+    if(!memcmp(at,a.to,a.length))return Write::Done;
+    if(!matches(a,at)) {poison(latch);return Write::Failed;}
+    if(!commit(latch))return Write::Skipped;
+    for(size_t i=0;i<a.length;++i) if(at[i]!=a.to[i])at[i]=a.to[i];
+    return !memcmp(at,a.to,a.length)?Write::Done:Write::Failed;
+}
