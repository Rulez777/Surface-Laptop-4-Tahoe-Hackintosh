+        __atomic_load_n(&rejectedPort1,__ATOMIC_RELAXED),
+        __atomic_load_n(&active,__ATOMIC_ACQUIRE) ? 1U : 0U
+    };
+    auto data=OSData::withBytes(values,sizeof(values));
+    if(!data)return false;
+    const bool ok=data->serialize(serializer);
+    data->release();
+    return ok;
