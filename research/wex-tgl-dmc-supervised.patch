+// SL4 Tiger Lake DMC v2.12 source-only trial. All hooks fail closed on
+// unrecognized donor offsets/prologues, and are gated on -wex-sl4-tgl-dmc.
+void XE::wrapSL4DMCInit(void *controller) {
+    auto self=callbackXE;
+    if (!self) return;
+    if (self->orgSL4DMCInit)
+        FunctionCast(wrapSL4DMCInit,self->orgSL4DMCInit)(controller);
+    if (!controller)return;
+    uint32_t readback=0;
+    const bool ok=SL4DMCTrial::upload(controller,self->sl4DMCRegWrite,
+                                     self->sl4DMCRegRead,&readback);
+    auto root=IORegistryEntry::getRegistryRoot();
+    if(root) {
+        root->setProperty("SL4DMCLocalInitReadback",readback);
+        root->setProperty("SL4DMCLocalInitVerified",ok);
+    }
+    // Save only a controller whose live MMIO upload succeeded. A successful
+    // patch registration is not equivalent to a completed hardware upload.
+    if(ok)self->sl4DMCSavedFramebufferController=controller;
+}
+void XE::wrapSL4DMCWake(void *accelerator) {
+    auto self=callbackXE;
+    if(!self)return;
+    if(self->orgSL4DMCWake)
+        FunctionCast(wrapSL4DMCWake,self->orgSL4DMCWake)(accelerator);
+    bool ok=false;
+    uint32_t back=0;
+    // This pointer lifetime is not yet proven on Surface across Deep Idle;
+    // this opt-in candidate must not be installed without supervised testing.
+    if(self->sl4DMCSavedFramebufferController)
+        ok=SL4DMCTrial::upload(self->sl4DMCSavedFramebufferController,
+                               self->sl4DMCRegWrite,self->sl4DMCRegRead,&back);
+    auto root=IORegistryEntry::getRegistryRoot();
+    if(root) {
+        root->setProperty("SL4DMCLocalWakeReadback",back);
+        root->setProperty("SL4DMCLocalWakeVerified",ok);
+    }
+}
+bool XE::routeSL4DMCInit(KernelPatcher &patcher,size_t index,
+                         mach_vm_address_t address,size_t size) {
+    if(!checkKernelArgument("-wex-sl4-tgl-dmc") || !tglRequested ||
+       tglDeviceId!=0x9A49)return false;
+    constexpr const char *init="__ZN31AppleIntelFramebufferController18hwInitializeCStateEv";
+    constexpr const char *wr="__ZN31AppleIntelRegisterAccessManager19FastWriteRegister32Emj";
+    constexpr const char *rd="__ZN31AppleIntelRegisterAccessManager18FastReadRegister32Em";
+    static const uint8_t initHead[]={0x55,0x48,0x89,0xE5,0x41,0x57,0x41,0x56,0x53,0x50};
+    static const uint8_t ioHead[]={0x55,0x48,0x89,0xE5,0x48,0xFF,0x05};
+    const auto initFn=patcher.solveSymbol<mach_vm_address_t>(index,init,address,size);
+    const auto wrFn=patcher.solveSymbol<mach_vm_address_t>(index,wr,address,size);
+    const auto rdFn=patcher.solveSymbol<mach_vm_address_t>(index,rd,address,size);
+    bool qualified=size>0x5EDA0 && initFn==address+0x43972 &&
+        wrFn==address+0x5ED7E && rdFn==address+0x5ED62 &&
+        !memcmp(reinterpret_cast<void *>(initFn),initHead,sizeof(initHead)) &&
+        !memcmp(reinterpret_cast<void *>(wrFn),ioHead,sizeof(ioHead)) &&
+        !memcmp(reinterpret_cast<void *>(rdFn),ioHead,sizeof(ioHead));
+    patcher.clearError();
+    if(qualified) {
+        sl4DMCRegWrite=wrFn;sl4DMCRegRead=rdFn;
+        KernelPatcher::RouteRequest route(init,wrapSL4DMCInit,orgSL4DMCInit);
+        qualified=patcher.routeMultiple(index,&route,1,address,size);
+        patcher.clearError();
+    }
+    sl4DMCFramebufferHookReady=qualified;
+    if(auto root=IORegistryEntry::getRegistryRoot())
+        root->setProperty("SL4DMCLocalInitHookReady",qualified);
+    return qualified;
+}
