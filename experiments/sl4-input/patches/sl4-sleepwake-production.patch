+void VoodooGPIO::lidGPEWatchdogTimerFired(IOTimerEventSource *sender) {
+    if (sender != lidGPEWatchdogTimer)
+        return;
+    if (!controllerIsAwake) {
+        sender->setTimeoutMS(1000);
+        return;
+    }
+
+    constexpr UInt32 softwarePin = 0x12B;
+    constexpr unsigned hardwarePin = 206;
+    struct intel_community *community = nullptr;
+    struct intel_padgroup *padgrp = nullptr;
+    const SInt32 hwPin = intel_gpio_to_pin(softwarePin, &community, &padgrp);
+    if (hwPin == static_cast<SInt32>(hardwarePin) && community && padgrp &&
+        community->regs && community->pad_regs) {
+        const UInt32 groupIndex = hardwarePin - padgrp->base;
+        const UInt32 communityIndex = hardwarePin - community->pin_base;
+        const UInt64 physicalBase = community->mmap ? community->mmap->getPhysicalAddress() : 0;
+        const UInt32 nregs = (community->features & PINCTRL_FEATURE_DEBOUNCE) ? 4 : 2;
+        const UInt32 padbar = readl(community->regs + PADBAR);
+        const UInt32 padOffset = padbar + communityIndex * nregs * 4;
+        const bool mapValid =
+            groupIndex == 11 && communityIndex == 35 && padgrp->reg_num == 1 &&
+            (physicalBase & 0x00FFFFFFULL) == 0x006A0000ULL && padOffset == 0x930 &&
+            community->gpe_sts_offset == 0x140 && community->gpe_en_offset == 0x160;
+        IOVirtualAddress padcfg = mapValid ? intel_get_padcfg(hardwarePin, PADCFG0) : 0;
+        if (padcfg) {
+            const UInt32 padcfg0 = readl(padcfg);
+            const UInt32 rawInput = (padcfg0 & PADCFG0_GPIORXSTATE) ? 1 : 0;
+            const UInt32 rxDisabled = (padcfg0 & PADCFG0_GPIORXDIS) ? 1 : 0;
+            const UInt32 pinMode = (padcfg0 & PADCFG0_PMODE_MASK) >> PADCFG0_PMODE_SHIFT;
+            const UInt32 sciRoute = (padcfg0 & PADCFG0_GPIROUTSCI) ? 1 : 0;
+            const UInt32 rxEvent = (padcfg0 & PADCFG0_RXEVCFG_MASK) >> PADCFG0_RXEVCFG_SHIFT;
+            const bool safe = !rxDisabled && !pinMode && sciRoute &&
+                rxEvent == PADCFG0_RXEVCFG_LEVEL &&
+                intel_pad_owned_by_host(hardwarePin) && intel_pad_acpi_mode(hardwarePin);
+
+            if (rawInput != lidGPERecoveryLastRaw) {
+                lidGPERecoveryLastRaw = rawInput;
+                lidGPERecoveryStableSamples = 1;
+                lidGPERecoveryAttempted = false;
+            } else if (lidGPERecoveryStableSamples < 2) {
+                ++lidGPERecoveryStableSamples;
+            }
+
+            if (safe && lidGPERecoveryStableSamples >= 2 && !lidGPERecoveryAttempted) {
+                const UInt32 bit = static_cast<UInt32>(1U << groupIndex);
+                const UInt32 enableOffset = community->gpe_en_offset + padgrp->reg_num * 4;
+                IOVirtualAddress enableReg = community->regs + enableOffset;
+                const UInt32 before = readl(enableReg);
+                if (!(before & bit)) {
+                    lidGPERecoveryAttempted = true;
+                    // Preserve pending GPE_STS; the OEM _L4B handler owns acknowledgement.
+                    writel(before | bit, enableReg);
+                    if (!(readl(enableReg) & bit))
+                        lidGPERecoveryAttempted = false;
+                }
+            }
+        }
+    }
+    sender->setTimeoutMS(1000);
+}
