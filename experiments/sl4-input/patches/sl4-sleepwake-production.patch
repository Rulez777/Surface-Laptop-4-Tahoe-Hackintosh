+IOReturn VoodooGPIO::armSurfaceLidWakeGPE() {
+    // Surface Laptop 4 / Tiger Lake-LP OEM DSDT: GPIO 0x090C000B -> GPP_F11.
+    constexpr UInt32 lidSoftwarePin = 0x12B;
+    constexpr unsigned lidHardwarePin = 206;
+    struct intel_community *community = nullptr;
+    struct intel_padgroup *padgrp = nullptr;
+    SInt32 mappedPin = intel_gpio_to_pin(lidSoftwarePin, &community, &padgrp);
+    if (mappedPin != static_cast<SInt32>(lidHardwarePin) || !community || !padgrp) {
+        return kIOReturnNoInterrupt;
+    }
+
+    const unsigned groupIndex = lidHardwarePin - padgrp->base;
+    const unsigned communityIndex = lidHardwarePin - community->pin_base;
+    const UInt64 physicalBase = community->mmap ? community->mmap->getPhysicalAddress() : 0;
+    const bool mapValid =
+        groupIndex == 11 &&
+        communityIndex == 35 &&
+        padgrp->reg_num == 1 &&
+        community->gpe_sts_offset == 0x140 &&
+        community->gpe_en_offset == 0x160 &&
+        (physicalBase & 0x00FFFFFFULL) == 0x006A0000ULL;
+    if (!mapValid) {
+        return kIOReturnUnsupported;
+    }
+
+    IOVirtualAddress padcfg = intel_get_padcfg(lidHardwarePin, PADCFG0);
+    if (!padcfg) {
+        return kIOReturnNoResources;
+    }
+    UInt32 padcfg0 = readl(padcfg);
+    const UInt32 rxDisabled = (padcfg0 & PADCFG0_GPIORXDIS) ? 1 : 0;
+    const UInt32 pinMode = (padcfg0 & PADCFG0_PMODE_MASK) >> PADCFG0_PMODE_SHIFT;
+    const UInt32 sciRoute = (padcfg0 & PADCFG0_GPIROUTSCI) ? 1 : 0;
+    const UInt32 rxEvent = (padcfg0 & PADCFG0_RXEVCFG_MASK) >> PADCFG0_RXEVCFG_SHIFT;
+    // RXINV is deliberately not constrained or changed: OEM _L4B/SGII toggles it
+    // to prepare the opposite lid transition.
+    if (rxDisabled || pinMode != 0 || !sciRoute || rxEvent != PADCFG0_RXEVCFG_LEVEL) {
+        return kIOReturnNotReady;
+    }
+
+    const UInt32 rawInput = (padcfg0 & PADCFG0_GPIORXSTATE) ? 1 : 0;
+    const UInt32 rxInvertBefore = (padcfg0 & PADCFG0_RXINV) ? 1 : 0;
+    const UInt32 desiredRxInvert = rawInput;
+    if (rxInvertBefore != desiredRxInvert) {
+        // Exact OEM DSDT equivalent: SGII(0x090C000B, GGIV(0x090C000B)).
+        // Clear the read-only RXSTATE bit in the write value; preserve every other PADCFG0 bit.
+        UInt32 updatedPadCfg0 = (padcfg0 & ~(PADCFG0_RXINV | PADCFG0_GPIORXSTATE)) |
+                                (desiredRxInvert ? PADCFG0_RXINV : 0);
+        writel(updatedPadCfg0, padcfg);
+        padcfg0 = readl(padcfg);
+    }
+    const UInt32 rxInvertAfter = (padcfg0 & PADCFG0_RXINV) ? 1 : 0;
+    if (rxInvertAfter != desiredRxInvert) {
+        return kIOReturnNotReady;
+    }
+
+    const UInt32 bit = static_cast<UInt32>(1U << groupIndex);
+    const UInt32 statusOffset = community->gpe_sts_offset + padgrp->reg_num * 4;
+    const UInt32 enableOffset = community->gpe_en_offset + padgrp->reg_num * 4;
+    const UInt32 statusBefore = readl(community->regs + statusOffset);
+    const UInt32 enableBefore = readl(community->regs + enableOffset);
+    // setWakeForHardwarePin clears only this GPE_STS bit (W1C), then enables
+    // only this GPE_EN bit with a read-modify-write, preserving neighbouring pads.
+    const IOReturn result = setWakeForHardwarePin(lidHardwarePin, true);
+    const UInt32 statusAfter = readl(community->regs + statusOffset);
+    const UInt32 enableAfter = readl(community->regs + enableOffset);
+    const bool armed = result == kIOReturnSuccess && (enableAfter & bit);
+    return armed ? kIOReturnSuccess : (result == kIOReturnSuccess ? kIOReturnError : result);
 }
 
